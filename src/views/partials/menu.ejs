<div id="menu" class="menu-container" tabindex="1">
    <div class="navBar">
        <ul>
            <li class="menuTabs button" id="lookTab"><i class="fa-solid fa-eye"></i> Look</li>
            <li class="menuTabs button" id="apparelTab"><i class="fa-solid fa-sack-dollar"></i> Apparel</li>
            <li class="menuTabs button" id="spellsTab"><i class="fa-solid fa-scroll"></i> Spells</li>
            <li class="menuTabs button" id="mapTab"><i class="fa-solid fa-map"></i> Map</li>
            <li class="menuTabs button" id="voreTab"><i class="fa-solid fa-utensils"></i> Vore</li>
            <li class="menuTabs button" id="optionsTab"><i class="fa-solid fa-gears"></i> Opts</li>
        </ul>
    </div>

    <!-- Content (Pinned Notes) -->
    <div id="menuDisplay">
        <div id="lookDisplay" class="tabDisplay">
            <div class="paper-note">
                <h3>Inspection</h3>
                <p>Right click an object or character to examine it closely.</p>
                <p><em>"Look closer, there is always more to see..."</em></p>
            </div>
        </div>

        <div id="apparelDisplay" class="tabDisplay">
            <div class="paper-note" style="text-align: center; padding: 20px 15px;">
                <h3 style="margin-top: 0;">Apparel Registry</h3>
                <i class="fa-solid fa-shirt" style="font-size: 2.5rem; color: var(--wood-light); margin: 15px 0; display: block;"></i>
                <p>Equipment management has popped out into a dedicated floating window.</p>
                <button id="reopenApparelWindowBtn" class="btn-primary" style="margin-top: 15px; width: 100%;">
                    <i class="fa-solid fa-window-restore"></i> Open Apparel Window
                </button>
            </div>
        </div>

        <div id="spellsDisplay" class="tabDisplay">
            <div class="paper-note">
                <h3>Spellbook</h3>
                <table id="spellsTable">
                    <tbody>
                        <tr>
                            <td id="tableIcon" class="empty spell-icon-cell">
                                <div class="fill" draggable="true"></div>
                            </td>
                            <td id="tableName" class="empty spell-name-cell"></td>
                            <td id="tableDescrip" class="empty"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div id="mapDisplay" class="tabDisplay">
            <div class="paper-note map-note">
                <h3>World Map</h3>
                <i class="fa-solid fa-map-location-dot map-icon"></i>
                <p>Map data not loaded.</p>
            </div>
        </div>

        <!-- Vore Tab -->
        <div id="voreDisplay" class="tabDisplay">
            <!-- VORE DASHBOARD -->
            <div class="vore-dashboard-header">
                <h3 class="vore-dashboard-title"><i class="fa-solid fa-compass-drafting"></i> Vore Destinations</h3>
                <button id="openAnatomyForgeBtn" class="btn btn-primary action-btn"
                    onclick="setTimeout(() => { if(window.AnatomyForge) window.AnatomyForge.refreshLayout() }, 100)">
                    <i class="fa-solid fa-network-wired"></i> Open Forge
                </button>
            </div>

            <div id="voreListContainer" class="vore-list-container">
                <!-- Configured Destinations will appear here -->
            </div>



            <!-- Utilities needed by UI.js -->
            <div id="af-toast-container"></div>
            <input type="hidden" id="anatomyData_inGame">
        </div>

        <div id="optionsDisplay" class="tabDisplay">
            <div class="paper-note">
                <h3>System Options</h3>

                <div class="options-group">
                    <div class="setting-row">
                        <label class="toggle-switch-label">
                            <input type="checkbox" id="debugToggle">
                            <span class="toggle-slider"></span>
                        </label>
                        <span class="setting-text">Debug Mode (Hitboxes)</span>
                    </div>
                    <div class="setting-row" style="margin-top: 15px;">
                        <label class="toggle-switch-label">
                            <input type="checkbox" id="tutorialToggle" checked>
                            <span class="toggle-slider"></span>
                        </label>
                        <span class="setting-text">Show Interactive Tutorial Checklist</span>
                    </div>
                </div>

                <!-- Tutorial Refresher Section -->
                <div id="tutorial-refresher-section" class="debug-section" style="margin-top: 20px; display: block; background: rgba(62, 39, 35, 0.05); padding: 10px; border-radius: 4px; border: 1px dashed rgba(62, 39, 35, 0.2);">
                    <h4 style="margin: 0 0 10px 0; font-family: 'Cinzel', serif; color: var(--wood-dark); border-bottom: 1px solid rgba(62, 39, 35, 0.1); padding-bottom: 5px;">Interactive Controls Refresher</h4>
                    <div id="tutorial-refresher-list" style="font-size: 0.8rem; line-height: 1.5; color: var(--text-dark);">
                        <!-- Will be populated dynamically by tutorial.js -->
                    </div>
                </div>

                <!-- Debug Information Section (Hidden unless active) -->
                <div id="debug-info-section" class="debug-section">
                    <h4>Debug Statistics</h4>
                    <div class="debug-stat-row">
                        <span class="stat-label">Coordinates:</span>
                        <span id="debug-coords" class="stat-value">X: 0, Y: 0</span>
                    </div>
                    <div class="debug-stat-row">
                        <span class="stat-label">Latency (RTT):</span>
                        <span id="debug-rtt" class="stat-value">-</span>
                    </div>
                    <div class="debug-stat-row">
                        <span class="stat-label">Distance to Server:</span>
                        <span id="debug-dist" class="stat-value">-</span>
                    </div>

                    <div class="debug-stat-row">
                        <span class="stat-label">Bandwidth (Dn/Up):</span>
                        <span id="debug-bandwidth" class="stat-value">- / - B/s</span>
                    </div>

                    <div class="debug-stat-row">
                        <span class="stat-label">FPS / Entities:</span>
                        <span id="debug-render-stats" class="stat-value">- / -</span>
                    </div>

                    <div class="debug-graph-container">
                        <canvas id="debug-graph" width="240" height="100"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SETTINGS MODAL (Re-purposed for Anatomy Forge) -->
<div id="settingsModal" class="settings-modal"
    style="display:none; position:fixed; z-index:9000; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.8);">
    <div class="modal-content"
        style="width: 95vw; height: 90vh; margin: 5vh auto; background: var(--wood-dark); display: flex; flex-direction: column; overflow: hidden; border: 2px solid var(--wood-light); box-shadow: 0 0 20px black; border-radius: 8px;">

        <div class="modal-header"
            style="background: var(--wood-dark); color: var(--gold); border-bottom: 2px solid var(--wood-light); padding: 10px 20px; flex-shrink: 0; display: flex; justify-content: space-between; align-items: center;">
            <h2 id="modalTitle" style="margin:0; font-family:'Cinzel'; font-size: 1.5rem;">Anatomy Forge</h2>
            <span class="close"
                style="cursor:pointer; font-size:2rem; line-height:1; color: var(--wood-light);">&times;</span>
        </div>

        <div class="modal-body" style="flex: 1; padding: 0; overflow: hidden; position: relative;">
            <!-- ANATOMY FORGE CONTAINER -->
            <div class="af-wrapper" id="anatomy-forge-container">
                <%- include('./anatomy_forge', { mode: 'play' }) %>
            </div>

        </div>
    </div>
</div>