<% const currentMode=(typeof mode !=='undefined' ) ? mode : 'create' ; %>

    <!-- SIDEBAR (Tools) -->
    <div class="af-sidebar">
        <div class="af-logo" style="font-size: 0.9rem;">✦ Anatomy Forge ✦</div>
        <div class="af-tool-category">
            <div class="af-category-title">System Nodes</div>

            <div class="af-node-btn" onmousedown="AnatomyForge.startDragNewNode(event, 'entrance')">
                <div class="af-dot" style="background: var(--node-entrance)"></div> Entrance
            </div>
            <div class="af-node-btn" onmousedown="AnatomyForge.startDragNewNode(event, 'path')">
                <div class="af-dot" style="background: var(--node-path)"></div> Path
            </div>
            <div class="af-node-btn" onmousedown="AnatomyForge.startDragNewNode(event, 'destination')">
                <div class="af-dot" style="background: var(--node-dest)"></div> Destination
            </div>
            <div class="af-node-btn" onmousedown="AnatomyForge.startDragNewNode(event, 'exit')">
                <div class="af-dot" style="background: var(--node-exit)"></div> Exit
            </div>
        </div>

        <div
            style="margin-top:auto; font-size: 0.6rem; color: var(--wood-light); text-align: center; opacity: 0.7; padding: 5px;">
            Right-Click/Drag to Pan.<br>Scroll to Zoom.<br><strong>Right-Click lines to cut.</strong>
        </div>
    </div>

    <!-- MAIN WORKSPACE -->
    <div class="af-canvas-container" id="af-canvas-container" oncontextmenu="return false;"
        style="flex: 1; position: relative; overflow: hidden;">
        <div id="af-world" style="position: absolute; top:0; left:0; width:100%; height:100%; transform-origin: 0 0;">
            <svg id="af-connections-layer"
                style="position: absolute; top:-5000px; left:-5000px; width:10000px; height:10000px; pointer-events: none;"></svg>
            <!-- Node DIVs via JS -->
        </div>

        <div class="af-hint-text"
            style="position: absolute; bottom: 10px; left: 10px; color: rgba(255,255,255,0.2); font-style: italic; font-family: 'Cinzel'; pointer-events: none;">
            "The map of the body is the map of the soul..."
        </div>

        <div class="af-zoom-controls"
            style="position: absolute; bottom: 10px; right: 10px; display: flex; flex-direction: column; gap: 5px;">
            <button type="button" class="af-zoom-btn" title="Fit to Screen (R)"
                onclick="AnatomyForge.resetView()">R</button>

            <% if (currentMode==='play' ) { %>
                <button type="button" class="af-zoom-btn" title="Save Changes" style="color: #4cd137;"
                    onclick="window.saveAnatomyChanges(true)">
                    <i class="fa-solid fa-floppy-disk"></i>
                </button>
                <% } else { %>
                    <button type="button" class="af-zoom-btn" title="Clear Map" style="margin-top:5px; color: #ff6b6b;"
                        onclick="AnatomyForge.clearMap()">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                    <% } %>
        </div>
    </div>

    <!-- INSPECTOR PANEL -->
    <div class="af-inspector" id="af-inspector">
        <div class="af-inspector-header">
            <span id="af-inspector-title">Properties</span>
            <span class="af-close-inspector" style="cursor:pointer; float:right;"
                onclick="document.getElementById('af-inspector').classList.remove('visible')">&times;</span>
        </div>
        <div id="af-inspector-content"></div>
    </div>

    <!-- UTILITIES & MODALS -->
    <!-- Note: af-toast-container is expected to be provided by the parent view to avoid ID conflicts -->

    <div id="af-connection-tooltip" class="af-connection-tooltip">Right-click to delete</div>

    <div id="af-confirm-modal" class="af-modal-overlay">
        <div class="af-modal-box" id="af-modal-box">
            <div class="af-modal-title" id="af-modal-title">Destroy Node?</div>
            <div class="af-modal-msg" id="af-modal-msg">Permanently remove this node?</div>

            <div class="af-modal-checkbox-container" id="af-modal-checkbox-container" style="display:none;">
                <input type="checkbox" id="af-modal-confirm-check">
                <label for="af-modal-confirm-check">I understand this action is irreversible.</label>
            </div>

            <div class="af-modal-actions">
                <button type="button" class="af-btn-cancel"
                    onclick="document.getElementById('af-confirm-modal').classList.remove('active')">Cancel</button>
                <button type="button" class="af-btn-confirm" id="af-btn-confirm-delete">Yes, Proceed</button>
            </div>
        </div>
    </div>