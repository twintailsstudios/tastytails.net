<!-- Character Bank Page Stylesheet -->
<link rel="stylesheet" href="/css/character-bank.css">

<!-- Main Content -->
<main>
  <div class="page-title">
    <h2>Character Registry</h2>
    <p>Select your persona to enter the world...</p>
  </div>

  <!-- The Container where JS will inject cards -->
  <div id="bankUl" class="character-grid">
    <!-- Cards go here -->
  </div>
</main>

<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteModal" class="modal-overlay">
  <div class="modal-box">
    <h2 id="modalTitle">Delete Character?</h2>
    <p>Are you sure you want to rip up this registration? Once they are gone, they cannot be summoned back.</p>

    <ul class="warning-list">
      <li>Character Looks & Design</li>
      <li>Written Biography</li>
      <li>Interaction Preferences</li>
      <li>All Custom Interactions</li>
    </ul>

    <div class="checkbox-container">
      <input type="checkbox" id="confirmDeleteCheck">
      <label for="confirmDeleteCheck">I understand this action is permanent and cannot be undone.</label>
    </div>

    <form id="deleteForm" method="POST" action="/api/user/deletecharacter/">
      <input type="hidden" name="charId" id="deleteInputId">
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary btn-cancel" onclick="closeModal()">No, Keep Them</button>
        <button type="submit" id="finalDeleteBtn" class="btn btn-danger btn-delete" disabled>Yes, Delete</button>
      </div>
    </form>
  </div>
</div>

<% if (charList !== null) { %>
  <!-- Hardened JSON container tag preventing </script> breakout -->
  <script id="char-data" type="application/json">
    <%- JSON.stringify(charList).replace(/</g, '\\u003c') %>
  </script>
  <script>
    /**
     * @fileoverview Character Bank View Hydration & Grid Controller (character-bank.ejs)
     * 
     * @description
     * Server-rendered EJS view controller that hydrates the player's character roster
     * from MongoDB, renders character cards dynamically via client-side JS, and handles
     * context menus and character soft-deletion confirmation modals.
     * 
     * @trigger GET /character-bank (Express route handler in src/routes/index.js)
     */

    /* ===========================================
       DATA & CONFIGURATION
       ===========================================
    */

    // SAFE HYDRATION: Read serialized character payload from application/json script container
    let charList = [];
    try {
      const dataContainer = document.getElementById('char-data');
      if (dataContainer && dataContainer.textContent.trim()) {
        charList = JSON.parse(dataContainer.textContent);
      }
    } catch (err) {
      console.error('Failed to parse character registry JSON:', err);
      charList = [];
    }

    // DOM Element References
    const grid = document.getElementById('bankUl');
    const modal = document.getElementById('deleteModal');
    const modalTitle = document.getElementById('modalTitle');
    const deleteInputId = document.getElementById('deleteInputId');
    const confirmCheck = document.getElementById('confirmDeleteCheck');
    const finalDeleteBtn = document.getElementById('finalDeleteBtn');
    const deleteForm = document.getElementById('deleteForm');

    /**
     * Helper: Escapes unsafe HTML characters to prevent DOM-based Cross-Site Scripting (XSS).
     * @param {string} str - Raw input string
     * @returns {string} Sanitized string safe for HTML text node insertion
     */
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    /**
     * Helper: Converts MongoDB hex format (0xRRGGBB) to CSS hex format (#RRGGBB).
     * @param {string} hexString - Hex color code string (e.g., '0x636363')
     * @returns {string} CSS compatible hex color string (e.g., '#636363')
     */
    function formatColor(hexString) {
      if (!hexString) return '#ccc';
      return hexString.replace('0x', '#');
    }

    /**
     * Helper: Maps numeric pronoun codes stored in DB to human-readable strings.
     * @param {number} pCode - Numeric pronoun code (1=She/Her, 2=He/Him, 3=They/Them)
     * @returns {string} Formatted pronoun label
     */
    function getPronouns(pCode) {
      if (pCode === 1) return "She/Her";
      if (pCode === 2) return "He/Him";
      if (pCode === 3) return "They/Them";
      return "Unknown";
    }

    /* ===========================================
       RENDER LOGIC
       ===========================================
    */

    /**
     * OPTIMIZATION: Generates character cards and appends them in a single DocumentFragment batch.
     * Reduces DOM layout reflows from N iterations to 1 atomic paint frame.
     */
    function renderCharacters() {
      grid.innerHTML = ''; // Clear existing content
      const fragment = document.createDocumentFragment();

      charList.forEach((char) => {
        const charId = char._id;
        const displayName = char.nickName || char.firstName || "Unknown";
        const fullName = (char.firstName && char.lastName) ? `${char.firstName} ${char.lastName}` : "Unknown Identity";
        const species = char.speciesName || "Unknown";
        const pronouns = getPronouns(char.pronouns);
        const desc = char.icDescrip || "No description provided.";
        const headColor = formatColor(char.head?.color);

        // Sanitize string variables before string interpolation
        const safeDisplayName = escapeHtml(displayName);
        const safeFullName = escapeHtml(fullName);
        const safeSpecies = escapeHtml(species);
        const safePronouns = escapeHtml(pronouns);
        const safeDesc = escapeHtml(desc);

        // Create Card Container
        const card = document.createElement('div');
        card.className = 'char-card';

        // SECURITY: Attributes use data-id and data-name to avoid inline JS quote escaping issues
        card.innerHTML = `
                <div class="card-header">
                    <div class="card-pin"></div>
                    <h3 class="nickname">${safeDisplayName}</h3>
                    <div class="fullname">${safeFullName}</div>
                    
                    <!-- Settings Gear Icon -->
                    <button class="card-options-btn" data-id="${charId}">
                        <i class="fa-solid fa-gear"></i>
                    </button>
                    
                    <!-- Context Menu (Hidden by default) -->
                    <div id="menu-${charId}" class="context-menu">
                        <ul>
                            <li><a href="#" class="btn-delete-card" data-id="${charId}" data-name="${safeDisplayName}"><i class="fa-solid fa-trash"></i> Delete</a></li>
                        </ul>
                    </div>
                </div>
                
                <div class="card-body">
                    <div class="species-badge">${safeSpecies}</div>
                    
                    <!-- Avatar Placeholder: Uses data color for background -->
                    <div class="avatar-placeholder" style="background-color: ${headColor}">
                        <i class="fa-solid fa-paw"></i>
                    </div>
                    
                    <div class="stats">
                        <div class="stat-row">
                            <i class="fa-solid fa-venus-mars" style="font-size: 0.8rem; margin-top:3px;"></i> 
                            <span>${safePronouns}</span>
                        </div>
                    </div>
                    <div class="description-preview">"${safeDesc}"</div>
                </div>
                
                <div class="card-footer">
                    <a href="play/${charId}" class="btn btn-play"><i class="fa-solid fa-play"></i> Play</a>
                    <a href="edit/${charId}" class="btn btn-edit"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
                </div>
            `;

        fragment.appendChild(card);
      });

      // "Add New" Card (Always at the end)
      const addCard = document.createElement('a');
      addCard.href = "/create";
      addCard.className = "char-card add-card";
      addCard.innerHTML = `
            <div class="add-icon"><i class="fa-solid fa-circle-plus"></i></div>
            <div class="add-text">Register New</div>
        `;
      fragment.appendChild(addCard);

      // Single-batch DOM insertion
      grid.appendChild(fragment);
    }

    /* ===========================================
       INTERACTION HANDLERS
       ===========================================
    */

    /**
     * Toggles visibility of the card context menu dropdown.
     * @param {string} id - Character MongoDB object ID
     */
    function toggleMenu(id) {
      const menu = document.getElementById(`menu-${id}`);
      // Close all other open context menus first
      document.querySelectorAll('.context-menu').forEach(m => {
        if (m.id !== `menu-${id}`) m.classList.remove('visible');
      });
      if (menu) menu.classList.toggle('visible');
    }

    /**
     * Opens the shared character deletion modal dialog.
     * @param {string} id - Character MongoDB object ID
     * @param {string} name - Display name of character to delete
     */
    function openDeleteModal(id, name) {
      modalTitle.innerText = `Delete ${name}?`;
      deleteInputId.value = id;

      // Reset modal state and submit button label
      confirmCheck.checked = false;
      finalDeleteBtn.disabled = true;
      finalDeleteBtn.classList.remove('active');
      finalDeleteBtn.innerText = 'Yes, Delete';

      modal.classList.add('active');
    }

    /**
     * Closes the character deletion modal overlay.
     */
    function closeModal() {
      modal.classList.remove('active');
    }

    /**
     * OPTIMIZATION & DELEGATION: Single event listener on container grid (#bankUl).
     * Uses .closest() to correctly identify targets when clicking child icon <i> tags.
     */
    grid.addEventListener('click', function (event) {
      const optionsBtn = event.target.closest('.card-options-btn');
      if (optionsBtn) {
        event.preventDefault();
        const charId = optionsBtn.dataset.id;
        toggleMenu(charId);
        return;
      }

      const deleteBtn = event.target.closest('.btn-delete-card');
      if (deleteBtn) {
        event.preventDefault();
        const charId = deleteBtn.dataset.id;
        const charName = deleteBtn.dataset.name;
        openDeleteModal(charId, charName);
        return;
      }
    });

    // Global Click Listener: Close open context menus when clicking outside options buttons
    document.addEventListener('click', function (event) {
      if (!event.target.closest('.card-options-btn')) {
        document.querySelectorAll('.context-menu').forEach(m => m.classList.remove('visible'));
      }
    });

    // Enable Delete Button only when confirmation checkbox is explicitly checked
    confirmCheck.addEventListener('change', function () {
      if (this.checked) {
        finalDeleteBtn.disabled = false;
        finalDeleteBtn.classList.add('active');
      } else {
        finalDeleteBtn.disabled = true;
        finalDeleteBtn.classList.remove('active');
      }
    });

    // Double-submit protection: Lock submit button on post request submission
    if (deleteForm) {
      deleteForm.addEventListener('submit', function () {
        finalDeleteBtn.disabled = true;
        finalDeleteBtn.innerText = 'Deleting...';
      });
    }

    // Expose global wrappers for legacy/backward compatibility
    window.toggleMenu = toggleMenu;
    window.openDeleteModal = openDeleteModal;
    window.closeModal = closeModal;

    // Initialize Page
    renderCharacters();

  </script>
  <% } else { %>
    <script>
      console.log('No current characters');
    </script>
    <% } %>