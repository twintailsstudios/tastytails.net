<script>
  var rawCharList = `<%- JSON.stringify(charList)
    .replace(/\\/g, '\\\\')
    .replace(/'/g, '\\\'')
    .replace(/"/g, '&quot;')
    .replace(/\n/g, '\\n')
    .replace(/\r/g, '\\r')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029') %>`;
  window.TASTY_TAILS_CHAR_DATA = rawCharList === 'new' ? 'new' : JSON.parse(rawCharList.replace(/&quot;/g, '"'));
</script>
