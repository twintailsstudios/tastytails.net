    // 1. Load Singles
    assetConfig.singles.forEach(key => {
      // Handle the path difference for 'empty' vs others if strictly necessary, 
      // but inspecting previous code: 'empty' used 'empty.png', others used key name.
      // 'empty' was: ./../assets/spritesheets/empty.png
      // 'body_01-empty' was: ./../assets/spritesheets/empty.png  <-- WAIT, these used the SAME file?
      // Let's check the original code again.
      // Yes: this.load.spritesheet('body_01-empty', './../assets/spritesheets/empty.png'...

      let path = `./../assets/spritesheets/${key}.png`;
      if (key.includes('empty')) path = './../assets/spritesheets/empty.png';

      // frameWidth 109 for empty, 215 for others?
      // Original: empty was 109x220. regular assets 215x198.
      const dims = key.includes('empty') ? { frameWidth: 109, frameHeight: 220 } : { frameWidth: 215, frameHeight: 198 };

      this.load.spritesheet(key, path, dims);
      this.spritesToAnimate.push(key);
    });

    // 2. Load Groups
    assetConfig.groups.forEach(group => {
      if (group.customLoop) {
        group.run(this);
      } else {
        const suffixes = group.suffixes || [''];
        for (let i = 1; i <= group.count; i++) {
