<%#
/**
 * @fileoverview create.ejs - Character Creator & Editor View Template
 *
 * @description
 * Primary view template for character creation and character editing.
 * Renders the multi-tab ledger configuration form alongside a live 2D Phaser character mirror.
 *
 * Triggered by:
 * - GET /create (src/routes/index.js)
 * - GET /edit/:charId (src/routes/edit.js)
 * - Redirect from GET /play (src/routes/play.js)
 *
 * Client Script Dependencies:
 * - /js/creator/CharacterPreviewScene.js (Phaser 3 Engine)
 * - /js/creator/ColorPickerManager.js (Pickr System & Palette Engine)
 * - /js/creator/CharacterCreatorApp.js (Form UI & Sync Controller)
 */
-%>
<% var charList = (typeof charList !== 'undefined' && charList) ? charList : 'new'; %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@simonwep/pickr/dist/themes/classic.min.css" />
<link rel="stylesheet" href="/css/create.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>">
<link rel="stylesheet" href="/css/anatomy_forge.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>">
<link rel="stylesheet" href="/css/loading.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>">
<script src="/js/anatomy_forge.js?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>"></script>



<div id="loading-overlay">
  <div id="loading-board">
    <!-- Game Title on the Wood -->
    <div id="loading-title">Character Creator</div>

    <!-- The Pinned Parchment -->
    <div id="loading-paper">
      <!-- Pins/Nails holding the paper -->
      <div class="loading-pin tl"></div>
      <div class="loading-pin tr"></div>

      <!-- Loading Content -->
      <div id="loading-text">Preparing the Mirror...</div>
      <div id="loading-bar-container">
        <div id="loading-bar-fill"></div>
      </div>
      <div id="loading-percent">0%</div>
    </div>
  </div>
</div>

<section id="characterCreator">
  <div class="creator-grid">
    <!-- LEFT COLUMN: THE LEDGER -->
    <div class="ledger-container">
      <!-- TABS -->
      <div id="primaryButtons">
        <ul>
          <li><button type="button" id="identity" class="button main active-tab"><span><i class="fa-solid fa-id-card"></i> Identity </span></button></li>
          <li><button type="button" id="gender" class="button main"><span><i class="fa-solid fa-palette"></i> Appearance </span></button></li>
          <li><button type="button" id="about" class="button main"><span><i class="fa-solid fa-feather-pointed"></i> About </span></button></li>
          <li><button type="button" id="kinks" class="button main"><span><i class="fa-solid fa-heart"></i> Kinks </span></button></li>
          <li><button type="button" id="vore" class="button main" onclick="if(window.AnatomyForge) window.AnatomyForge.refreshLayout()"><span><i class="fa-solid fa-utensils"></i> Vore </span></button></li>
        </ul>
      </div>

      <!-- FORM CONTENT -->
      <% if (charList=='new' ) { %>
        <form action="/api/user/createcharacter" method="POST">
          <% } else {%>
            <form action="/api/user/editcharacter" method="POST">
              <% if (charList && charList._id) { %>
                <input type="hidden" name="charId" value="<%= charList._id %>">
                <% } %>
                  <%}%>

                    <!-- 1. IDENTITY TAB (NEW 1st TAB) -->
                    <div id="identityPullout" class="pullout" style="display:block;">
                      <h2 class="section-heading"><i class="fa-solid fa-dna"></i> Identity & Core Archetype</h2>
                      <p class="section-sub">Define your character's gender presentation, reproductive anatomy, body plan, and vocal profile.</p>

                      <!-- Presentation & Shape -->
                      <div class="identity-card-section">
                        <div class="card-section-title"><i class="fa-solid fa-venus-mars"></i> Presentation & Shape</div>
                        <div class="pill-toggle-group" data-target="bodyShape">
                          <button type="button" class="pill-btn active" data-value="F-"><i class="fa-solid fa-venus"></i> Feminine</button>
                          <button type="button" class="pill-btn" data-value="M-"><i class="fa-solid fa-mars"></i> Masculine</button>
                        </div>
                        <select name="bodyShape" id="bodyShape" style="display:none;">
                          <option value="F-">Feminine</option>
                          <option value="M-">Masculine</option>
                        </select>
                      </div>

                      <!-- Reproductive Anatomy -->
                      <div class="identity-card-section">
                        <div class="card-section-title"><i class="fa-solid fa-shield-heart"></i> Reproductive Anatomy</div>
                        <div class="pill-toggle-group" data-target="genitals">
                          <button type="button" class="pill-btn active" data-value="empty"><i class="fa-solid fa-venus"></i> Vagina</button>
                          <button type="button" class="pill-btn" data-value="penis"><i class="fa-solid fa-mars"></i> Penis</button>
                          <button type="button" class="pill-btn" data-value="both"><i class="fa-solid fa-venus-mars"></i> Both</button>
                        </div>
                        <select name="genitals" id="genitals" style="display:none;">
                          <option value="empty">Vagina</option>
                          <option value="penis">Penis</option>
                          <option value="both">Both</option>
                        </select>
                      </div>

                      <!-- Body Plan & Archetype -->
                      <div class="identity-card-section">
                        <div class="card-section-title"><i class="fa-solid fa-person-running"></i> Body Plan & Archetype</div>
                        <div class="archetype-grid-cards" data-target="mainBodyType">
                          <button type="button" class="archetype-card active" data-value="body_01">
                            <div class="archetype-icon"><i class="fa-solid fa-user-ninja"></i></div>
                            <div class="archetype-title">Anthropomorphic</div>
                            <div class="archetype-sub">Bipedal animal form</div>
                          </button>
                          <button type="button" class="archetype-card" data-value="body_02">
                            <div class="archetype-icon"><i class="fa-solid fa-horse"></i></div>
                            <div class="archetype-title">Taur</div>
                            <div class="archetype-sub">Quadrupedal lower body</div>
                          </button>
                          <button type="button" class="archetype-card" data-value="body_03">
                            <div class="archetype-icon"><i class="fa-solid fa-staff-snake"></i></div>
                            <div class="archetype-title">Naga</div>
                            <div class="archetype-sub">Serpentine lower body</div>
                          </button>
                          <button type="button" class="archetype-card" data-value="body_04">
                            <div class="archetype-icon"><i class="fa-solid fa-spider"></i></div>
                            <div class="archetype-title">Drider</div>
                            <div class="archetype-sub">Arachnid lower body</div>
                          </button>
                        </div>
                        <select name="mainBodyType" id="mainBodyType" style="display:none;">
                          <option value="body_01">Anthropomorphic</option>
                          <option value="body_02">Taur</option>
                          <option value="body_03">Naga</option>
                          <option value="body_04">Drider</option>
                        </select>
                      </div>

                      <!-- Voice Synthesizer Studio -->
                      <div class="identity-card-section">
                        <div class="card-section-title"><i class="fa-solid fa-microphone-lines"></i> Voice Synthesizer Studio</div>
                        <div id="voiceStudioContainer"></div>
                        <input type="hidden" name="voiceProfile" id="voiceProfileInput" value='<%= charList && charList.voiceProfile ? JSON.stringify(charList.voiceProfile) : "" %>'>
                      </div>
                    </div>

                    <!-- 2. APPEARANCE TAB (FORMERLY STYLE) -->
                    <div id="genderPullout" class="pullout" style="display:none;">
                      <!-- Color Sync Toolbar -->
                      <div class="appearance-toolbar">
                        <div class="color-sync-wrapper">
                          <label class="color-sync-label" title="When enabled, changing body color automatically updates Head, Ears, and Tail colors in unison">
                            <input type="checkbox" id="colorSyncToggle" checked>
                            <span class="sync-slider"></span>
                            <span class="sync-text"><i class="fa-solid fa-link"></i> Sync Feature Colors</span>
                          </label>
                        </div>
                      </div>

                      <!-- Sub-Category Navigation Bar -->
                      <div class="appearance-sub-nav">
                        <button type="button" class="sub-nav-btn active" data-sub="subTabHead"><i class="fa-solid fa-face-smile"></i> Head & Face</button>
                        <button type="button" class="sub-nav-btn" data-sub="subTabBody"><i class="fa-solid fa-child"></i> Body & Coat</button>
                        <button type="button" class="sub-nav-btn" data-sub="subTabTail"><i class="fa-solid fa-feather"></i> Tail & Markings</button>
                        <button type="button" class="sub-nav-btn" data-sub="subTabHair"><i class="fa-solid fa-sparkles"></i> Hair & Horns</button>
                      </div>

                      <!-- Sub-Category Content Panes -->
                      <div class="appearance-sub-content">

                        <!-- 1. HEAD & FACE SUB-TAB -->
                        <div id="subTabHead" class="sub-tab-pane active">
                          <div class="style-grid active">
                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Head Species:</label>
                                <select name="head" id="head">
                                  <option value="head_01">Vulpine</option>
                                  <option value="head_02">Canine</option>
                                  <option value="head_03">Feline</option>
                                  <option value="head_04">Bunny</option>
                                  <option value="head_05">Avian</option>
                                  <option value="head_06">Reptile</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="headColorBtn" class="pcr-button" title="Head Primary Color"></button></div>
                              </div>
                            </div>

                            <!-- Dynamic Beak -->
                            <div class="selectionContainer" id="sneakyBeak" style="display:none;">
                              <div class="input-group">
                                <label>Beak Color:</label>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="beakColorBtn" class="pcr-button" title="Beak Color"></button></div>
                              </div>
                              <input id="beakSprite" name="beakSprite" type="hidden">
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Head Secondary Fur:</label>
                                <select name="headSecondaryFur" id="headSecondaryFur">
                                  <option value="empty">None</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="secondaryHeadColorBtn" class="pcr-button" title="Head Secondary Color"></button></div>
                              </div>
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Head Accent Fur:</label>
                                <select name="headAccentFur" id="headAccentFur">
                                  <option value="empty">None</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="accentHeadColorBtn" class="pcr-button" title="Head Accent Color"></button></div>
                              </div>
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Ears:</label>
                                <select name="outerEar" id="outerEar">
                                  <option value="empty">None</option>
                                  <option value="ears_01-outer">Perky and Pointy</option>
                                  <option value="ears_02-outer">Floppy</option>
                                  <option value="ears_03-outer">Smol and Pointy</option>
                                  <option value="ears_04-outer">Long and Loppy</option>
                                  <option value="ears_05-outer">Long and Tall</option>
                                  <option value="ears_06-outer">Split Tip</option>
                                  <option value="ears_07-outer">From Sides</option>
                                  <option value="ears_08-outer">Deer/Cow</option>
                                  <option value="ears_09-outer">Mouse/Rat</option>
                                  <option value="ears_10-outer">Squirrel</option>
                                  <option value="ears_11-outer">Lynx</option>
                                </select>
                                <input id="innerEar" name="innerEar" type="hidden" value="ears_01-inner">
                              </div>
                              <div style="display:flex; gap:5px;">
                                <div class="pickr"><button type="button" id="outerEarColorBtn" class="pcr-button" title="Outer Ear Color"></button></div>
                                <div class="pickr"><button type="button" id="innerEarColorBtn" class="pcr-button" title="Inner Ear Color"></button></div>
                              </div>
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Eye Color:</label>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="eyeColorBtn" class="pcr-button" title="Eye Iris Color"></button></div>
                                <input id="eyesIris" name="eyesIris" type="hidden" value="eyes_01">
                                <input id="eyesOuter" name="eyesOuter" type="hidden" value="eyes_02">
                              </div>
                            </div>
                          </div>
                        </div>

                        <!-- 2. BODY & COAT SUB-TAB -->
                        <div id="subTabBody" class="sub-tab-pane">
                          <div class="style-grid active">
                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Primary Body Color:</label>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="bodyColorBtn" class="pcr-button" title="Primary Body Color"></button></div>
                              </div>
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Secondary Fur:</label>
                                <select name="bodySecondaryFur" id="bodySecondaryFur">
                                  <option value="body_01-empty">None</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="secondaryBodyColorBtn" class="pcr-button" title="Body Secondary Color"></button></div>
                              </div>
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Accent Fur:</label>
                                <select name="bodyAccentFur" id="bodyAccentFur">
                                  <option value="body_01-empty">None</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="accentBodyColorBtn" class="pcr-button" title="Body Accent Color"></button></div>
                              </div>
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Hands Markings:</label>
                                <select name="handsFur" id="handsFur">
                                  <option value="body_01-empty">None</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="handsColorBtn" class="pcr-button" title="Hands Color"></button></div>
                              </div>
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Feet Markings:</label>
                                <select name="feetFur" id="feetFur">
                                  <option value="body_01-empty">None</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="feetColorBtn" class="pcr-button" title="Feet Color"></button></div>
                              </div>
                            </div>
                          </div>
                        </div>

                        <!-- 3. TAIL & MARKINGS SUB-TAB -->
                        <div id="subTabTail" class="sub-tab-pane">
                          <div class="style-grid active">
                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Tail Type:</label>
                                <select name="tail" id="tail">
                                  <option value="tail_01">Vulpine</option>
                                  <option value="tail_02">Canine</option>
                                  <option value="tail_03">Feline</option>
                                  <option value="tail_04">Rabbit</option>
                                  <option value="tail_05">Avian</option>
                                  <option value="tail_06">Reptile</option>
                                  <option value="tail_07">Equine</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="tailColorBtn" class="pcr-button" title="Tail Primary Color"></button></div>
                              </div>
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Tail Secondary Fur:</label>
                                <select name="tailSecondaryFur" id="tailSecondaryFur">
                                  <option value="empty">None</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="secondaryTailColorBtn" class="pcr-button" title="Tail Secondary Color"></button></div>
                              </div>
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Tail Accent Fur:</label>
                                <select name="tailAccentFur" id="tailAccentFur">
                                  <option value="empty">None</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="accentTailColorBtn" class="pcr-button" title="Tail Accent Color"></button></div>
                              </div>
                            </div>
                          </div>
                        </div>

                        <!-- 4. HAIR & HORNS SUB-TAB -->
                        <div id="subTabHair" class="sub-tab-pane">
                          <div class="style-grid active">
                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Hair Style:</label>
                                <select name="hair" id="hair">
                                  <option value="empty">None</option>
                                  <option value="hair-front_01">Short Bob</option>
                                  <option value="hair-front_02">Pony Tail</option>
                                  <option value="hair-front_03">Covers Eye</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="hairColorBtn" class="pcr-button" title="Hair Color"></button></div>
                              </div>
                            </div>

                            <div class="selectionContainer">
                              <div class="input-group">
                                <label>Accessories & Horns:</label>
                                <select name="headAccessories" id="headAccessories">
                                  <option value="empty">None</option>
                                  <option value="headAccessories_01">Nubby horns</option>
                                  <option value="headAccessories_02">Antlers</option>
                                  <option value="headAccessories_03">Dragon Horns</option>
                                  <option value="headAccessories_04">Antenna</option>
                                  <option value="headAccessories_05">Unicorn Horn</option>
                                </select>
                              </div>
                              <div>
                                <div class="pickr"><button type="button" id="headAccessoriesColorBtn" class="pcr-button" title="Accessories Color"></button></div>
                              </div>
                            </div>
                          </div>
                        </div>

                      </div>

                      <div class="colorContainer">
                        <!-- <canvas id="color-picker"></canvas>
                  <br>-->
                        <div class="hexContainer">
                          <div class="colorQuickSelect">
                            <!-- Color Hex Value: <br> -->
                            <input id="primaryHeadHex" name="primaryHeadColor" type="hidden" autocomplete="off"
                              class="hexReadOut" placeholder="Hex Value" aria-label="Hex Value"></input>
                          </div>
                          <div class="colorQuickSelect">
                            <!-- Color Hex Value: <br> -->
                            <input id="beakHex" name="beakHex" type="hidden" autocomplete="off" class="hexReadOut"
                              placeholder="Hex Value" aria-label="Hex Value"></input>
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="secondaryHeadHex" name="secondaryHeadColor" type="hidden" autocomplete="off"
                                class="hexReadOut" placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                            <!-- <div class="copyDivide">
            Copy Your Head's Primary Color? <br>
            <button type="button" class="button colorQuickSelectBtn" style="vertical-align:middle"><span></span></button>
          </div> -->
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="accentHeadHex" name="accentHeadColor" type="hidden" autocomplete="off"
                                class="hexReadOut" placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                            <!-- <div class="copyDivide">
            Copy Your Head's Secondary Color? <br>
            <button type="button" class="button colorQuickSelectBtn" style="vertical-align:middle"><span></span></button>
          </div> -->
                          </div>
                          <div class="colorQuickSelect">
                            <!-- Color Hex Value: <br> -->
                            <input id="hairHex" name="hairColor" type="hidden" autocomplete="off" class="hexReadOut"
                              placeholder="Hex Value" aria-label="Hex Value"></input>
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="outerEarHex" name="outerEarColor" type="hidden" autocomplete="off"
                                class="hexReadOut" placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="innerEarHex" name="innerEarColor" type="hidden" autocomplete="off"
                                class="hexReadOut" placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                          </div>
                          <div class="colorQuickSelect">
                            <!-- Color Hex Value: <br> -->
                            <input id="eyesHex" name="eyesColor" type="hidden" autocomplete="off" class="hexReadOut"
                              placeholder="Hex Value" aria-label="Hex Value"></input>
                          </div>
                          <div class="colorQuickSelect">
                            <!-- Color Hex Value: <br> -->
                            <input id="headAccessoriesHex" name="headAccessoriesColor" type="hidden" autocomplete="off"
                              class="hexReadOut" placeholder="Hex Value" aria-label="Hex Value"></input>
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="bodyHex" name="bodyColor" type="hidden" autocomplete="off" class="hexReadOut"
                                placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                            <!-- <div class="copyDivide">
            Copy Your Head's Primary Color? <br>
            <button type="button" class="button colorQuickSelectBtn" style="vertical-align:middle"><span></span></button>
          </div> -->
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="secondaryBodyHex" name="secondaryBodyColor" type="hidden" autocomplete="off"
                                class="hexReadOut" placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                            <!-- <div class="copyDivide">
            Copy Your Head's Secondary Color? <br>
            <button type="button" class="button colorQuickSelectBtn" style="vertical-align:middle"><span></span></button>
          </div> -->
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="accentBodyHex" name="accentBodyColor" type="hidden" autocomplete="off"
                                class="hexReadOut" placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                            <!-- <div class="copyDivide">
            Copy Your Head's Accent Color? <br>
            <button type="button" class="button colorQuickSelectBtn" style="vertical-align:middle"><span></span></button>
          </div> -->
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="handsHex" name="handsColor" type="hidden" autocomplete="off" class="hexReadOut"
                                placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                            <!-- <div class="copyDivide">
            Copy Your Head's Secondary Color? <br>
            <button type="button" class="button colorQuickSelectBtn" style="vertical-align:middle"><span></span></button>
          </div> -->
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="feetHex" name="feetColor" type="hidden" autocomplete="off" class="hexReadOut"
                                placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                            <!-- <div class="copyDivide">
            Copy Your Head's Secondary Color? <br>
            <button type="button" class="button colorQuickSelectBtn" style="vertical-align:middle"><span></span></button>
          </div> -->
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="tailHex" name="tailColor" type="hidden" autocomplete="off" class="hexReadOut"
                                placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                            <!-- <div class="copyDivide">
            Copy Your Body's Primary Color? <br>
            <button type="button" class="button colorQuickSelectBtn" style="vertical-align:middle"><span></span></button>
          </div> -->
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="secondaryTailHex" name="secondaryTailColor" type="hidden" autocomplete="off"
                                class="hexReadOut" placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                            <!-- <div class="copyDivide">
            Copy Your Body's Secondary Color? <br>
            <button type="button" class="button colorQuickSelectBtn" style="vertical-align:middle"><span></span></button>
          </div> -->
                          </div>
                          <div class="colorQuickSelect">
                            <div class="hexDivide">
                              <!-- Color Hex Value: <br> -->
                              <input id="accentTailHex" name="accentTailColor" type="hidden" autocomplete="off"
                                class="hexReadOut" placeholder="Hex Value" aria-label="Hex Value"></input>
                            </div>
                            <!-- <div class="copyDivide">
            Copy Your Body's Accent Color? <br>
            <button type="button" class="button colorQuickSelectBtn" style="vertical-align:middle"><span></span></button>
          </div> -->
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- 3. ABOUT TAB (PROFILE STUDIO) -->
                    <div id="aboutPullout" class="pullout">
                      <h2 class="section-heading"><i class="fa-solid fa-feather-pointed"></i> Character Profile Studio</h2>
                      <p class="section-sub">Design your character's identity, visual impression, and roleplay boundaries as seen when players examine you in-game.</p>

                      <!-- 1. PERSONAL DETAILS CARD -->
                      <div class="identity-card-section">
                        <div class="card-section-title"><i class="fa-solid fa-address-card"></i> Personal Details</div>
                        <div class="bio-fields-grid">
                          <div class="bio-field">
                            <label for="firstName"><i class="fa-solid fa-signature"></i> First Name:</label>
                            <input id="firstName" name="firstName" type="text" placeholder="e.g. Shela" autocomplete="off">
                          </div>
                          <div class="bio-field">
                            <label for="lastName"><i class="fa-solid fa-signature"></i> Last Name:</label>
                            <input id="lastName" name="lastName" type="text" placeholder="e.g. Vulpis" autocomplete="off">
                          </div>
                          <div class="bio-field">
                            <label for="nickName"><i class="fa-solid fa-tag"></i> Nickname / Alias:</label>
                            <input id="nickName" name="nickName" type="text" placeholder="e.g. Red" autocomplete="off">
                          </div>
                          <div class="bio-field">
                            <label for="speciesName"><i class="fa-solid fa-paw"></i> Species:</label>
                            <input id="speciesName" name="speciesName" type="text" placeholder="e.g. Red Fox" autocomplete="off">
                          </div>
                        </div>

                        <!-- Pronouns Pill Toggles -->
                        <div class="bio-pronouns-wrapper">
                          <label class="pronouns-label"><i class="fa-solid fa-venus-mars"></i> Pronouns:</label>
                          <div class="pill-toggle-group" id="pronounPillGroup">
                            <button type="button" class="pill-btn active" data-value="1"><i class="fa-solid fa-venus"></i> She / Her</button>
                            <button type="button" class="pill-btn" data-value="2"><i class="fa-solid fa-mars"></i> He / Him</button>
                            <button type="button" class="pill-btn" data-value="3"><i class="fa-solid fa-genderless"></i> They / Them</button>
                          </div>
                          <div style="display:none;">
                            <input type="radio" name="pronouns" value="1" id="she/her" checked>
                            <input type="radio" name="pronouns" value="2" id="he/his">
                            <input type="radio" name="pronouns" value="3" id="they/them">
                          </div>
                        </div>
                      </div>

                      <!-- 2. AUTHENTIC IN-GAME EXAMINE MODAL PREVIEW -->
                      <div class="examine-modal-preview-wrapper">
                        <div class="examine-modal-window">
                          <div class="examine-modal-topbar">
                            <div class="examine-modal-title"><i class="fa-solid fa-magnifying-glass"></i> Examine Window Preview</div>
                            <span class="preview-badge"><i class="fa-solid fa-eye"></i> In-Game View</span>
                          </div>

                          <div class="examine-modal-content">
                            <!-- Character Header Banner -->
                            <div class="examine-char-header">
                              <div class="examine-char-name" id="previewCharName">Shela Vulpis</div>
                              <div class="examine-char-meta">
                                <span class="meta-pill" id="previewSpecies" data-tooltip="Species"><i class="fa-solid fa-paw"></i> Red Fox</span>
                                <span class="meta-pill" id="previewPronouns" data-tooltip="Pronouns"><i class="fa-solid fa-venus"></i> She / Her</span>
                                <span class="meta-pill alias-pill" id="previewAlias" data-tooltip="Nickname"><i class="fa-solid fa-tag"></i> "Red"</span>
                              </div>
                            </div>

                            <!-- Examine Modal Tabs (Look vs OOC Notes) -->
                            <div class="examine-modal-tabs">
                              <button type="button" class="examine-tab-btn active" data-tab="examineLookPane"><i class="fa-solid fa-eye"></i> Look</button>
                              <button type="button" class="examine-tab-btn" data-tab="examineOocPane"><i class="fa-solid fa-user-shield"></i> OOC Notes</button>
                            </div>

                            <!-- Tab Panes -->
                            <div class="examine-tab-content">
                              <div id="examineLookPane" class="examine-pane active">
                                <div class="examine-content-box" id="previewIcContent">
                                  <em>Your character's physical impression will appear here...</em>
                                </div>
                              </div>

                              <div id="examineOocPane" class="examine-pane">
                                <div class="examine-content-box ooc-box" id="previewOocContent">
                                  <em>OOC guidelines and roleplay boundaries will appear here...</em>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- 3. DESCRIPTION & BOUNDARIES EDITORS -->
                      <div class="editors-2col-grid">
                        <!-- In-Character (IC) Description Studio -->
                        <div class="identity-card-section">
                          <div class="card-section-title"><i class="fa-solid fa-eye"></i> In-Character (IC) Description</div>
                          
                          <div class="bio-guide-banner ic-banner">
                            <i class="fa-solid fa-circle-info"></i>
                            <span><strong>What players physically see:</strong> Describe gait, posture, expressions, scent, clothing style, and immediate physical presence when standing in front of your character.</span>
                          </div>

                          <div class="editor-toolbar">
                            <div class="format-btn-group">
                              <button type="button" class="format-btn" data-format="bold" data-target="icDescrip" title="Bold Text"><i class="fa-solid fa-bold"></i></button>
                              <button type="button" class="format-btn" data-format="italic" data-target="icDescrip" title="Italic Text"><i class="fa-solid fa-italic"></i></button>
                              <button type="button" class="format-btn" data-format="quote" data-target="icDescrip" title="Quote Card"><i class="fa-solid fa-quote-left"></i></button>
                              <button type="button" class="format-btn" data-format="list" data-target="icDescrip" title="Bullet List"><i class="fa-solid fa-list-ul"></i></button>
                              <button type="button" class="format-btn" data-format="heading" data-target="icDescrip" title="Section Header"><i class="fa-solid fa-heading"></i></button>
                            </div>
                            <button type="button" class="template-btn" id="insertIcTemplate"><i class="fa-solid fa-wand-magic-sparkles"></i> Smart Impression Template</button>
                          </div>

                          <textarea id="icDescrip" name="icDescrip" class="profile-textarea" rows="7" placeholder="Describe your character's physical gait, posture, scent, clothing, and presence..."></textarea>
                        </div>

                        <!-- Out-of-Character (OOC) Notes & Boundaries Studio -->
                        <div class="identity-card-section">
                          <div class="card-section-title"><i class="fa-solid fa-user-shield"></i> Out-of-Character (OOC) Notes & Boundaries</div>
                          
                          <div class="bio-guide-banner ooc-banner">
                            <i class="fa-solid fa-shield-halved"></i>
                            <span><strong>Player boundaries & meta notes:</strong> Include roleplay limits, communication preferences, and scene guidelines that cannot be known just by looking at your character.</span>
                          </div>

                          <div class="editor-toolbar">
                            <div class="format-btn-group">
                              <button type="button" class="format-btn" data-format="bold" data-target="oocDescrip" title="Bold Text"><i class="fa-solid fa-bold"></i></button>
                              <button type="button" class="format-btn" data-format="italic" data-target="oocDescrip" title="Italic Text"><i class="fa-solid fa-italic"></i></button>
                              <button type="button" class="format-btn" data-format="warning" data-target="oocDescrip" title="Boundary Warning Box"><i class="fa-solid fa-triangle-exclamation"></i></button>
                              <button type="button" class="format-btn" data-format="list" data-target="oocDescrip" title="Bullet List"><i class="fa-solid fa-list-ul"></i></button>
                            </div>
                            <button type="button" class="template-btn" id="insertOocTemplate"><i class="fa-solid fa-shield"></i> Smart Boundaries Template</button>
                          </div>

                          <textarea id="oocDescrip" name="oocDescrip" class="profile-textarea" rows="7" placeholder="Include roleplay boundaries, OOC preferences, and player guidelines..."></textarea>
                        </div>
                      </div>

                    </div>



                    <!-- 3. KINKS TAB (REBUILT & REDESIGNED) -->
                    <div id="kinksPullout" class="pullout">
                      <h2 style="font-family:'Cinzel', serif; margin-bottom: 8px;">Preferences & Kinks</h2>
                      <p style="font-family: var(--font-handwriting, 'Caveat Brush', cursive); font-size: 1.15rem; margin-bottom: 20px; color: var(--wood-dark);">Rate your roleplay preferences from <strong>Hate It (-2)</strong> to <strong>Love It (+2)</strong> using heart ratings.</p>

                      <!-- Filter & Search Toolbar -->
                      <div class="kink-toolbar">
                        <div class="kink-search-wrapper">
                          <i class="fa-solid fa-magnifying-glass search-icon"></i>
                          <input type="text" id="kinkSearch" placeholder="Search kinks or descriptions..." autocomplete="off">
                        </div>
                        <div class="kink-filter-chips" id="kinkFilterChips">
                          <button type="button" class="filter-chip active" data-category="all">All</button>
                          <button type="button" class="filter-chip" data-category="vore">Vore</button>
                          <button type="button" class="filter-chip" data-category="transformation">Transformation</button>
                          <button type="button" class="filter-chip" data-category="roleplay">Roleplay</button>
                        </div>
                      </div>

                      <!-- Kinks Container -->
                      <div id="kinksContainer" class="kinks-grid">
                        <!-- Rendered dynamically by CharacterCreatorApp.js -->
                      </div>
                    </div>

                    <!-- 4. VORE TAB (ANATOMY FORGE) -->
                    <div id="vorePullout" class="pullout">
                      <div class="af-wrapper" id="anatomy-forge-container">
                        <%- include('partials/anatomy_forge', { mode: 'create' }) %>
                          <!-- Toast Container specific to Create Mode layout adjustments if any, or shared logic -->
                          <div id="af-toast-container"></div>
                      </div>

                      <!-- DATA PERSISTENCE -->
                      <input type="hidden" name="anatomyData" id="anatomyData">
                      <div id="legacy-shim-container"></div>
                    </div>



                    <!-- NAVIGATION BUTTONS -->
                    <div id="buttonHolder">
                      <button type="button" id="next" class="btn btn-secondary button main" style="width:auto;"><span>Next <i
                            class="fa-solid fa-arrow-right"></i></span></button>
                      <button type="button" id="next2" class="btn btn-secondary button main" style="width:auto; display:none;"><span>Next
                          <i class="fa-solid fa-arrow-right"></i></span></button>
                      <button type="button" id="next3" class="btn btn-secondary button main" style="width:auto; display:none;"><span>Next
                          <i class="fa-solid fa-arrow-right"></i></span></button>
                      <button type="button" id="next4" class="btn btn-secondary button main" style="width:auto; display:none;"><span>Next
                          <i class="fa-solid fa-arrow-right"></i></span></button>
                      <button type="submit" id="finish" class="btn btn-primary button main"
                        style="width:auto; display:none;"><span>Finish <i
                            class="fa-solid fa-check"></i></span></button>
                    </div>
            </form>
    </div>
    <!-- RIGHT COLUMN: PREVIEW MIRROR -->
    <div id="previewContainer">
      <div id="previewAndButtons">
        <div id="preview">
          <!-- Phaser Canvas -->
        </div>
      </div>

      <div class="preview-controls">
        <div class="control-group">
          <label class="control-label">View</label>
          <div class="btn-row">
            <button type="button" id="rotateLeft" class="button preview-btn"><i class="fa-solid fa-rotate-left"></i>
              <span>Left</span></button>
            <button type="button" id="rotateRight" class="button preview-btn"><span>Right</span> <i
                class="fa-solid fa-rotate-right"></i></button>
          </div>
        </div>

        <div class="control-group">
          <label class="control-label">Actions</label>
          <div class="btn-row">
            <button type="button" id="randomizer" class="button preview-btn"><i class="fa-solid fa-dice"></i>
              <span>Randomize</span></button>
            <button type="button" id="resetMainDefaults" class="button preview-btn secondary"><i
                class="fa-solid fa-trash-can-arrow-up"></i> <span>Reset</span></button>
          </div>
        </div>

        <div class="control-group">
          <label class="control-label">Base Palette</label>
          <div class="palette-grid">
            <div class="palette-item"><span>Primary</span>
              <div class="pickr"><button type="button" class="mainPrimaryColorBtn pcr-button"></button>
              </div>
            </div>
            <div class="palette-item"><span>Secondary</span>
              <div class="pickr"><button type="button" id="mainSecondaryColorBtn" class="pcr-button"></button>
              </div>
            </div>
            <div class="palette-item"><span>Accent</span>
              <div class="pickr"><button type="button" id="mainAccentColorBtn" class="pcr-button"></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/phaser@3.24.1/dist/phaser.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
