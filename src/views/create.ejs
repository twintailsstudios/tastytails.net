            for (let i = 1; i <= 6; i++) {
              const headKey = `head_0${i}`;
              scene.load.spritesheet(headKey, `./../assets/spritesheets/${headKey}.png`, { frameWidth: 215, frameHeight: 198 });
              scene.spritesToAnimate.push(headKey);

              // Secondary masks for each head
              for (let j = 1; j <= 5; j++) {
                const secKey = `${headKey}-secondary_0${j}`;
                scene.load.spritesheet(secKey, `./../assets/spritesheets/${secKey}.png`, { frameWidth: 215, frameHeight: 198 });
                scene.spritesToAnimate.push(secKey);
              }
            }
          }
        },

        // Tails (1-10) and their secondary masks (1-6)
        {
          customLoop: true,
          run: (scene) => {
            for (let i = 1; i <= 10; i++) {
              const tailNum = i < 10 ? `0${i}` : i;
              const tailKey = `tail_${tailNum}`;
              scene.load.spritesheet(tailKey, `./../assets/spritesheets/${tailKey}.png`, { frameWidth: 215, frameHeight: 198 });
              scene.spritesToAnimate.push(tailKey);

              // Secondary masks for each tail
              for (let j = 1; j <= 6; j++) {
                const secKey = `${tailKey}-secondary_0${j}`;
                scene.load.spritesheet(secKey, `./../assets/spritesheets/${secKey}.png`, { frameWidth: 215, frameHeight: 198 });
                scene.spritesToAnimate.push(secKey);
              }
            }
          }
        },

        // Hair (1-3)
        { prefix: 'hair-front_', count: 3 } // Fixed prefix from 'hair-front_0' to prevent double zero padding
      ]
    };

