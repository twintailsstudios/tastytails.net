<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- Phase 1: Horizontal Resizing ---
    const resizer = document.getElementById('resize-handler');
    const leftSide = document.getElementById('phaserApp');
    const rightSide = document.getElementById('sidePanel');
    const container = document.getElementById('game-wrapper');

    let x = 0;
    let leftWidth = 0;

    const mouseDownHandler = function (e) {
      x = e.clientX;
      leftWidth = leftSide.getBoundingClientRect().width;
      document.addEventListener('mousemove', mouseMoveHandler);
      document.addEventListener('mouseup', mouseUpHandler);
      document.body.classList.add('resizing');
    };

    const mouseMoveHandler = function (e) {
      const dx = e.clientX - x;
      const newLeftWidth = ((leftWidth + dx) * 100) / container.getBoundingClientRect().width;
      if (newLeftWidth < 20 || newLeftWidth > 80) return;
      leftSide.style.flex = `0 0 ${newLeftWidth}%`;
      window.dispatchEvent(new Event('resize'));
    };

    const mouseUpHandler = function () {
      document.removeEventListener('mousemove', mouseMoveHandler);
      document.removeEventListener('mouseup', mouseUpHandler);
      document.body.classList.remove('resizing');
      window.dispatchEvent(new Event('resize'));
    };

    if (resizer) resizer.addEventListener('mousedown', mouseDownHandler);

    // --- Phase 2: Vertical Resizing ---
    const vResizer = document.getElementById('vertical-resize-handler');
    const topPanel = document.getElementById('menu');
    const bottomPanel = document.getElementById('chat');
    const sidePanel = document.getElementById('sidePanel');

    let y = 0;
    let topHeight = 0;

    const vMouseDownHandler = function (e) {
      y = e.clientY;
      // Use getBoundingClientRect for accuracy
      topHeight = topPanel.getBoundingClientRect().height;

      document.addEventListener('mousemove', vMouseMoveHandler);
      document.addEventListener('mouseup', vMouseUpHandler);
      document.body.classList.add('resizing-v');
    };

    const vMouseMoveHandler = function (e) {
      const dy = e.clientY - y;
      const sidePanelHeight = sidePanel.getBoundingClientRect().height;

      // Calculate new percentage height
      const newTopHeightPct = ((topHeight + dy) * 100) / sidePanelHeight;

      // Constraints: Keep top between 20% and 80% (approx)
      if (newTopHeightPct < 10 || newTopHeightPct > 90) return;

      // Apply flex basis to top panel. 
      // IMPORTANT: Ensure topPanel has flex properties enabled in CSS or set here
      topPanel.style.flex = `0 0 ${newTopHeightPct}%`;
      // bottomPanel typically has flex: 1, so it fills the rest

      window.dispatchEvent(new Event('resize'));
    };

    const vMouseUpHandler = function () {
      document.removeEventListener('mousemove', vMouseMoveHandler);
      document.removeEventListener('mouseup', vMouseUpHandler);
      document.body.classList.remove('resizing-v');
    };

    if (vResizer) vResizer.addEventListener('mousedown', vMouseDownHandler);
  });
</script>

