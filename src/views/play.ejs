<script>
  // --- Anatomy Forge Integration ---
  // --- Anatomy Forge Integration ---
  window.saveAnatomyChanges = function (showToastMsg = true) {
    if (typeof AnatomyForge === 'undefined') return;

    // Use window.gameSocket if available
    // Do NOT call io() here as it creates a new connection every save!
    const targetSocket = window.gameSocket;

    if (targetSocket) {
      // Ensure we capture the latest data either from the hidden field or direct serialization
      const serialized = document.getElementById('anatomyData') ? document.getElementById('anatomyData').value : AnatomyForge.serialize();

      targetSocket.emit('updateVoreSettings', { anatomyData: serialized });

      if (showToastMsg) {
        if (typeof showToast === 'function') showToast("Anatomy Saved!", "success");
        else console.log("Anatomy Saved");
      }
    } else {
      console.warn("saveAnatomyChanges: No socket connection available.");
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof AnatomyForge !== 'undefined' && localPlayerInfo) {
      // We need to inject the hidden input 'anatomyData' because AnatomyForge expects it for serialization
      if (!document.getElementById('anatomyData')) {
        const inp = document.createElement('input');
        inp.type = 'hidden';
        inp.id = 'anatomyData';
        inp.name = 'anatomyData';
        document.body.appendChild(inp);
      }

      const initialData = localPlayerInfo.anatomyData || null;
      // We pass localPlayerInfo.voreTypes as legacy fallback
      AnatomyForge.init('anatomy-forge-container', initialData, localPlayerInfo.voreTypes, window.saveAnatomyChanges);

      // Hook into tab switching to resize/reset view
      const voreTabBtn = document.getElementById('voreTab');
      if (voreTabBtn) {
        voreTabBtn.addEventListener('click', () => {
          setTimeout(() => {
            AnatomyForge.resetView();
          }, 100);
        });
      }
    }
  });
</script>
