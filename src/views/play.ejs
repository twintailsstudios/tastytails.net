<div id="loading-overlay">
  <div id="loading-board">
    <!-- Game Title on the Wood -->
    <div id="loading-title">TastyTails</div>

    <!-- The Pinned Parchment -->
    <div id="loading-paper">
      <!-- Pins/Nails holding the paper -->
      <div class="loading-pin tl"></div>
      <div class="loading-pin tr"></div>

      <!-- Loading Content -->
