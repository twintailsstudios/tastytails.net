  <link rel="stylesheet" type="text/css" href="/css/crafting.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>" />
  <link rel="stylesheet" type="text/css" href="/css/apparel.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>" />

  <link rel="stylesheet" type="text/css" href="/css/options.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>" />
  <link rel="stylesheet" type="text/css" href="/css/loading.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>" />
  <link rel="stylesheet" type="text/css" href="/css/stats.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>" />
  <link rel="stylesheet" type="text/css" href="/css/medical.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>" />
  <link rel="stylesheet" type="text/css" href="/css/voreHUD.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>" />

  <!-- Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Black+Ops+One&family=Caveat+Brush&family=Cinzel:wght@400;700&family=Crimson+Pro:ital,wght@0,400;0,700;1,400&family=Fredoka:wght@400;600&family=Lato:ital,wght@0,400;0,700;1,400&family=MedievalSharp&family=Patrick+Hand&family=Philosopher:wght@400;700&family=Playfair+Display:ital@0;1&family=Rye&display=swap"
    rel="stylesheet">

  <!-- Icons & Tools -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@simonwep/pickr/dist/themes/classic.min.css">
  <link rel="stylesheet" href="/css/anatomy_forge.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>">
</head>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.body.classList.add('play-mode');
  });
</script>

<div id="game-wrapper">
  <!-- Sensory Overlays -->
  <div id="eye-damage-vignette"></div>
  <div id="pain-flash-overlay"></div>

  <!-- Medical Paper Doll Window -->
  <div id="medical-window" class="medical-window modal-box" style="display: none;">
    <!-- Hardware Rivets -->
    <div class="rivet tl"></div>
    <div class="rivet tr"></div>
    <div class="rivet bl"></div>
    <div class="rivet br"></div>

    <!-- Draggable Header -->
    <div class="window-header" id="medical-header">
      <div class="header-left">
        <i class="fa-solid fa-notes-medical header-icon"></i>
        <h2 class="window-title">Adventurer Medical Status</h2>
      </div>
      <div class="window-controls">
        <div class="minimize-btn" id="medical-btn-minimize" title="Minimize Window">_</div>
        <div class="close-btn" id="medical-btn-close" title="Close Window">✕</div>
      </div>
    </div>

    <!-- Window Body -->
    <div class="medical-body">
      <div class="paper-doll-container">
        <div id="paper-doll-svg-container"></div>
        <div id="paper-doll-pills-container" class="paper-doll-pills-container"></div>
      </div>
      <div class="medical-status-panel">
        <div class="summary-card">
          <div class="summary-row"><span class="summary-label">Blood Reserve:</span> <span id="med-blood-volume" class="summary-value">5000 / 5000 mL</span></div>
          <div class="summary-row"><span class="summary-label">Bleeding Rate:</span> <span id="med-bleed-rate" class="summary-value">0 mL/s</span></div>
          <div class="summary-row"><span class="summary-label">Total Health:</span> <span id="med-total-health" class="summary-value">100 / 100</span></div>
        </div>
        <!-- Anatomical Condition & Status Description Panel -->
        <div id="med-detail-panel" class="med-detail-panel">
          <div class="detail-panel-header">
            <span class="detail-title" id="med-detail-title">SELECTED: TORSO</span>
            <span class="detail-badge badge-ok" id="med-detail-badge">HEALTHY</span>
          </div>
          <div class="detail-panel-body" id="med-detail-body">
            <!-- Diagnostic rows injected dynamically by medicalUI.js -->
          </div>
        </div>
      </div>
    </div>

    <!-- Resize Handles -->
    <div class="resize-handle top"></div>
    <div class="resize-handle left"></div>
    <div class="resize-handle right"></div>
    <div class="resize-handle bottom"></div>
    <div class="resize-handle br"></div>
  </div>

  <!-- Minimized Floating Dock Pill Tab -->
  <div id="medical-minimized-tab" class="minimized-tab medical-tab-dock" style="display: none;">
    <div class="tab-icon"><i class="fa-solid fa-notes-medical"></i></div>
    <div class="tab-content">
      <div class="tab-title">Medical (<span id="dock-health-text">100 HP</span>)</div>
    </div>
    <div class="tab-controls">
      <div class="restore-btn" id="medical-tab-restore" title="Restore Window">☐</div>
    </div>
  </div>

  <!-- Second Wind Recovery Window (Pop-Out Overlay) -->
  <div class="window-container second-wind-window" id="second-wind-window" style="display: none; position: absolute; top: 35%; left: 40%; width: 320px; z-index: 10500;">
    <div class="rivet tl"></div>
    <div class="rivet tr"></div>
    <div class="rivet bl"></div>
    <div class="rivet br"></div>

    <div class="window-header" id="second-wind-header">
      <div class="header-left">
        <i class="fa-solid fa-person-rising header-icon" style="color: #e67e22;"></i>
        <h2 class="window-title">Second Wind Recovery</h2>
      </div>
      <div class="window-controls">
        <div class="close-btn" id="second-wind-btn-close" title="Close Window">✕</div>
      </div>
    </div>

    <div class="window-body" style="padding: 16px; text-align: center; display: flex; flex-direction: column; gap: 12px; background: var(--medical-bg-dark);">
      <p style="margin: 0; font-size: 0.9rem; color: #d4c5b9; line-height: 1.4;">
        You have caught your breath and regained enough strength to stand back up.
      </p>
      <button id="second-wind-action-btn" class="second-wind-action-btn" onclick="window.triggerSecondWind()">
        <i class="fa-solid fa-person-rising"></i> Catch Breath & Stand Up
      </button>
    </div>
  </div>

  <!-- Crafting UI Modal (Hearthside Forge) -->


  <!-- Crafting UI Modal (Hearthside Forge) -->
  <div class="crafting-overlay" id="crafting-overlay" style="display: none;">
    <div class="crafting-window" id="crafting-window">

      <!-- Structural Details (Rivets) -->
      <div class="rivet tl"></div>
      <div class="rivet tr"></div>
      <div class="rivet bl"></div>
      <div class="rivet br"></div>

      <!-- Top Header -->
      <div class="window-header" id="crafting-header">
        <h2 class="window-title" id="crafting-window-title">The Hearthside Forge</h2>
        <div class="window-controls">
          <div class="minimize-btn" id="crafting-btn-minimize">_</div>
          <div class="close-btn" id="crafting-btn-close">✕</div>
        </div>
      </div>

      <div class="window-body">
        <!-- LEFT COL: RECIPES -->
        <div class="recipe-book">
          <div class="recipe-header" id="crafting-recipe-header">Blueprints</div>
          <div class="recipe-list" id="recipe-list">
            <!-- Recipes are injected here by JS -->
          </div>
        </div>

        <!-- RIGHT COL: WORKSTATION -->
        <div class="workstation">
          <div class="anvil-surface">
            <!-- Flash FX layer -->
            <div class="flash-overlay" id="flashOverlay"></div>

            <!-- Top: Info about selected recipe -->
            <div class="crafting-info">
              <div class="selected-preview">
                <div class="preview-icon-lg" id="previewIcon">?</div>
                <div>
                  <h3 style="margin:0; font-family:'Cinzel', serif;" id="previewName">Select a Recipe</h3>
                  <span style="font-size:12px; opacity:0.7;" id="previewDesc">---</span>
                </div>
              </div>
              <div class="cost-display" id="costDisplay">
                <!-- Cost breakdown injected by JS -->
              </div>
            </div>

            <!-- Middle: Input Slots (The Crucible) -->
            <div style="font-size:12px; opacity:0.6; margin-bottom:5px;" id="crafting-input-label">Crucible (Deposit
              Materials)</div>
            <div class="input-zone" id="station-input-slot">
              <!-- Slots for Ingredients (Managed by JS) -->
            </div>

            <!-- Controls: Button & Progress Bar -->
            <div class="crafting-controls">
              <button class="craft-btn" id="crafting-action-btn">Strike Iron</button>
              <div class="progress-container">
                <div class="progress-bar" id="crafting-progress-bar"></div>
                <div class="progress-label" id="crafting-progress-label"></div>
              </div>
            </div>

            <!-- Bottom: Output Zone (Cooling Rack) -->
            <div class="output-zone">
              <div class="output-slot" id="outputSlot">
                <!-- Finished Item Appears Here -->
              </div>
              <div class="output-hint" id="outputHint">Cooling Rack</div>
            </div>

          </div>


        </div>
      </div>

      <!-- Resize Handles -->
      <div class="resize-handle top"></div>
      <div class="resize-handle left"></div>
      <div class="resize-handle right"></div>
      <div class="resize-handle bottom"></div>
      <div class="resize-handle br"></div>
    </div>
  </div>


  <!-- Minimized Crafting Tab (Floating) -->
  <div id="crafting-minimized-tab" class="minimized-tab" style="display: none;">
    <div class="tab-icon">⚒️</div>
    <div class="tab-content">
      <div class="tab-title" id="minimized-tab-title">Crafting Paused</div>
      <div class="tab-progress-bg">
        <div class="tab-progress-bar" id="crafting-tab-progress"></div>
      </div>
    </div>
    <div class="tab-controls">
      <div class="restore-btn" id="crafting-tab-restore">☐</div>
    </div>
  </div>

  <%- include('partials/apparel_window') %>

  <div id="navToggle" class="guild-crest-toggle" onclick="toggleNav()" title="Toggle Guild Navigation">
    <div class="crest-plate">
      <i class="fa-solid fa-dragon crest-icon"></i>
      <span class="crest-label">Guild Nav</span>
      <i class="fa-solid fa-chevron-down chevron-icon"></i>
    </div>
  </div>

  <div id="phaserApp" tabindex="0" oncontextmenu="return showContextMenu(event);">
    <%- include('partials/gameOverlay') %>

      <!-- Player Stats HUD -->
      <div id="stats-hud">
        <!-- Health -->
        <div id="health-bar-container" class="stat-bar-container clickable-stat-bar" onclick="if(window.toggleMedicalModal) window.toggleMedicalModal();" title="Click to view Medical Status">
          <div class="stat-icon"><i class="fa-solid fa-heart" style="color: #ff4c4c;"></i></div>
          <div class="stat-bar-track">
            <div id="health-bar-fill" class="stat-bar-fill" style="width: 100%;"></div>
            <span id="health-text" class="stat-text">100 / 100</span>
          </div>
        </div>
        <!-- Stamina -->
        <div class="stat-bar-container">
          <div class="stat-icon"><i class="fa-solid fa-bolt" style="color: #ffd700;"></i></div>
          <div class="stat-bar-track">
            <div id="stamina-bar-fill" class="stat-bar-fill" style="width: 100%;"></div>
            <span id="stamina-text" class="stat-text">100 / 100</span>
          </div>
        </div>
        <!-- Mana -->
        <div class="stat-bar-container">
          <div class="stat-icon"><i class="fa-solid fa-star" style="color: #4169e1;"></i></div>
          <div class="stat-bar-track">
            <div id="mana-bar-fill" class="stat-bar-fill" style="width: 100%;"></div>
            <span id="mana-text" class="stat-text">100 / 100</span>
          </div>
        </div>
      </div>

      <div id="dashboard-cluster">
        <!-- Master Adventurer Command Bar & Expanding Pocket Drawer -->
        <div id="dashboard-main-col">
          <!-- Inventory Drawer Slot (Flush on top of Master Command Bar Dock) -->
          <div id="inventory-drawer-slot"></div>

          <!-- Master Adventurer Command Bar Dock -->
          <div id="hands-hud" class="hands-hud command-bar-dock">
            <!-- Seam Overlapping Handle Tab -->
            <div id="pocket-collapse-handle" class="pocket-collapse-handle hidden-hud" title="Toggle Pockets">
              <span class="handle-icon"><i class="fa-solid fa-chevron-down"></i></span>
              <span class="handle-text">POCKETS</span>
            </div>

            <!-- Left Flank: Integrated Intent Controls & Target Paper Doll -->
            <div class="intent-dock-group">
              <div class="intent-option active intent-friendly" id="intent-friendly" onclick="setIntent('friendly', event)" title="Friendly Intent (Default)">
                <i class="fa-regular fa-face-smile"></i>
              </div>
              <div class="intent-option intent-grabbing" id="intent-grabbing" onclick="setIntent('grabbing', event)" title="Grabbing / Interacting Intent (Shift)">
                <i class="fa-solid fa-hand-fist"></i>
              </div>
              <div class="intent-option intent-hostile" id="intent-hostile" onclick="setIntent('hostile', event)" title="Hostile Intent (Ctrl)">
                <i class="fa-solid fa-crosshairs"></i>
              </div>
            </div>

            <!-- Target Selection Paper Doll Widget (Option A: Pop-Out Anatomical Target Lens) -->
            <div class="target-doll-dock-group" id="target-doll-widget">
              <!-- Mini Status Indicator Bar in HUD Dock -->
              <div class="target-dock-mini-btn" id="target-dock-mini-btn">
                <i class="fa-solid fa-bullseye target-dock-icon"></i>
                <div class="target-zone-label" id="target-zone-label">TORSO</div>
              </div>

              <!-- Floating Anatomical Hover Tooltip Card -->
              <div class="anatomy-hover-tooltip" id="target-anatomy-tooltip" style="display: none;">
                <div class="anatomy-tooltip-title" id="anatomy-tooltip-title">EAR (L)</div>
                <div class="anatomy-tooltip-hint" id="anatomy-tooltip-hint">SCRATCH LEFT EAR</div>
              </div>

              <!-- Floating Pop-Out Target Lens Card (180px x 240px) -->
              <div class="target-lens-popout" id="target-lens-popout" style="display: none;">
                <!-- Rivets -->
                <div class="rivet tl"></div>
                <div class="rivet tr"></div>
                <div class="rivet bl"></div>
                <div class="rivet br"></div>

                <div class="target-lens-header">
                  <span class="lens-title"><i class="fa-solid fa-crosshairs"></i> TARGET ANATOMY</span>
                  <div class="lens-close-btn" id="target-lens-close">✕</div>
                </div>

                <div class="target-lens-body">
                  <svg viewBox="0 0 180 240" class="target-lens-svg" xmlns="http://www.w3.org/2000/svg">
                    <!-- Head Base -->
                    <path class="target-zone-node node-head" data-zone="head" d="M 90 18 C 70 18, 70 58, 90 58 C 110 58, 110 18, 90 18 Z" />
                    <!-- Anime Cat Ears (Left & Right - Enlarged Hit Targets) -->
                    <path class="target-zone-node node-leftEar" data-zone="leftEar" d="M 80 22 L 56 0 C 56 0, 62 18, 72 28 Z" />
                    <path class="target-zone-node node-rightEar" data-zone="rightEar" d="M 100 22 L 124 0 C 124 0, 118 18, 108 28 Z" />
                    <!-- Eyes Zone (Unified Mask - Enlarged Hit Target) -->
                    <path class="target-zone-node node-eyes" data-zone="eyes" d="M 72 32 C 72 24, 85 24, 90 31 C 95 24, 108 24, 108 32 C 108 40, 95 40, 90 35 C 85 40, 72 40, 72 32 Z" />
                    <!-- Catgirl Mouth / Snout (:3 Shape - Enlarged Hit Target) -->
                    <path class="target-zone-node node-mouth" data-zone="mouth" d="M 76 43 C 76 54, 86 58, 90 49 C 94 58, 104 54, 104 43 C 104 54, 94 60, 90 60 C 86 60, 76 54, 76 43 Z" />
                    <!-- Torso -->
                    <path class="target-zone-node node-torso active" data-zone="torso" d="M 68 64 L 112 64 L 106 132 L 74 132 Z" />
                    <!-- Groin -->
                    <path class="target-zone-node node-groin" data-zone="groin" d="M 74 134 L 106 134 L 90 148 Z" />
                    <!-- Arms (Left & Right Separated) -->
                    <path class="target-zone-node node-leftArm" data-zone="leftArm" d="M 40 68 L 64 68 L 56 128 L 36 128 Z" />
                    <path class="target-zone-node node-rightArm" data-zone="rightArm" d="M 116 68 L 140 68 L 144 128 L 124 128 Z" />
                    <!-- Hands (Left & Right Separated) -->
                    <path class="target-zone-node node-leftHand" data-zone="leftHand" d="M 34 132 L 54 132 L 50 158 L 30 158 Z" />
                    <path class="target-zone-node node-rightHand" data-zone="rightHand" d="M 126 132 L 146 132 L 150 158 L 130 158 Z" />
                    <!-- Legs (Left & Right Separated) -->
                    <path class="target-zone-node node-leftLeg" data-zone="leftLeg" d="M 73 150 L 87 150 L 84 198 L 70 198 Z" />
                    <path class="target-zone-node node-rightLeg" data-zone="rightLeg" d="M 93 150 L 107 150 L 110 198 L 96 198 Z" />
                    <!-- Feet (Left & Right Separated) -->
                    <path class="target-zone-node node-leftFoot" data-zone="leftFoot" d="M 64 202 L 82 202 L 78 226 L 60 226 Z" />
                    <path class="target-zone-node node-rightFoot" data-zone="rightFoot" d="M 98 202 L 116 202 L 120 226 L 102 226 Z" />
                    <!-- Tail -->
                    <path class="target-zone-node node-tail" data-zone="tail" d="M 106 128 C 142 138, 142 178, 162 198 C 147 188, 132 158, 102 140 Z" />
                  </svg>
                </div>

                <div class="target-lens-footer" id="target-lens-footer">
                  <div class="lens-zone-title" id="lens-zone-title">TORSO</div>
                  <div class="lens-action-hint" id="lens-action-hint">HUG / PUNCH</div>
                </div>
              </div>
            </div>

            <!-- Center Core: Active Hands & Drop Action -->
            <div class="hands-dock-group">
              <div class="hand-slot left-hand" id="leftHandSlot" onclick="window.actionHands.onSlotClick('left', event)">
                <span class="hand-label">LEFT</span>
              </div>
              <div class="hand-slot right-hand" id="rightHandSlot" onclick="window.actionHands.onSlotClick('right', event)">
                <span class="hand-label">RIGHT</span>
              </div>
              <button id="drop-btn" class="hand-btn btn-danger">Drop</button>
            </div>

            <!-- Right Flank: Active Apparel Status Pill -->
            <div class="tabs-dock-group">
              <div id="active-apparel-pill" class="active-apparel-pill hidden-hud" title="Apparel Storage Pockets">
                <span id="pill-icon" class="pill-icon">📦</span>
                <span id="pill-text" class="pill-text">
                  <span class="pill-name">Pockets</span>
                  <span class="pill-count">(0/0)</span>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Toast Notification (Absolute) -->
        <div id="toast" class="toast"></div>
      </div>
  </div>

  <!-- Resize Handler -->
  <div id="resize-handler" class="resize-handler"></div>

  <div id="sidePanel">

    <%- include('partials/menu') %>

      <!-- Vertical Resize Handler -->
      <div id="vertical-resize-handler" class="resize-handler-v"></div>

      <%- include('partials/chat') %>

  </div>
</div>

<!-- Server State Hydration Block -->
<script>
  (function () {
    try {
      var rawCharList = `<%- JSON.stringify(charList)
        .replace(/\\/g, '\\\\')
        .replace(/'/g, '\\\'')
        .replace(/"/g, '&quot;')
        .replace(/\n/g, '\\n')
        .replace(/\r/g, '\\r')
        .replace(/\u2028/g, '\\u2028')
        .replace(/\u2029/g, '\\u2029') %>`;
      var charList = JSON.parse(rawCharList.replace(/&quot;/g, '"'));

      window.tastytailsData = {
        charList: charList,
        mapFilename: "<%= mapFilename %>"
      };

      window.localPlayerInfo = charList;
      window.localPlayerInfo.rotation = 0;
      window.localPlayerInfo.isMoving = false;
      window.mapFilename = window.tastytailsData.mapFilename;
    } catch (e) {
      console.error("Failed to parse initial player configuration:", e);
    }
  })();
</script>

<!-- Right Click Custom Menu (Moved to body to avoid clipping) -->
