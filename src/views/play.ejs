  <link rel="stylesheet" type="text/css" href="/css/chat.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>" />
  <link rel="stylesheet" type="text/css" href="/css/contextMenu.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>" />
