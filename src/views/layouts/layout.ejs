<!-- 
  @fileoverview layout.ejs - Master HTML Shell & Layout Template
  @description
  Provides the global HTML container, font/CSS asset links, header navigation,
  user authentication controls, connection alert banner, and sticky footer.
  Child view templates are injected into the body slot via express-ejs-layouts.
-->
<!DOCTYPE html>
<html>

<head>
  <meta name="viewport" content="width=device-width">
  <meta name="description" content="A place where you can eat and be eaten by your friends!">
  <meta name="keywords"
    content="vore, game, vore game, unbirth, anal vore, tail vore, transformation, TF, tasty, tails, tastytails, tasty tails, furry, yiff, role-playing, role-play, role play, RP, lewd, OwO,">
  <meta name="author" content="Kimberly Tilson">
  <title><%= typeof title !== 'undefined' ? title : 'TastyTails | Home' %></title>
  <script>window.APP_VERSION = "<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>";</script>
  <script src="/js/versionManager.js?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>"></script>
  <script src="/js/clientErrorReporter.js?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>"></script>
  <!-- OPTIMIZATION: Preconnect to Font CDNs for Fast Layout Paint -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/master.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '0.1.0' %>">
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Caveat+Brush&family=Crimson+Pro:ital,wght@0,400;0,700;1,400&family=Philosopher:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

</head>
<style>
  * {
    box-sizing: border-box;
  }

  body {
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: var(--palette-bg, #2c241b);
    background-image: var(--texture-wood-pattern, url('https://www.transparenttextures.com/patterns/wood-pattern.png'));
  }

  /* Ensure footer sticks to bottom */
  main,
  .content-wrapper {
    flex: 1;
  }
</style>

<body>
  <div id="connection-banner"
    style="display:none; position:fixed; top:0; left:0; width:100%; z-index:9999; text-align:center; padding:10px; font-weight:bold; color:white; background:orange; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
    Connection Unstable: Changes are being queued...
  </div>
  <header>
    <div class="container">
      <div class="headerLogo">
        <h1><i class="fa-solid fa-dragon"></i> TastyTails</h1>
      </div>
    </div>
  </header>
  <div id="smoke" class="<%= (typeof loginForm !== 'undefined' && loginForm == 1) ? '' : 'hide' %>"></div>
      <nav>
        <div class="container nav-container">
          <ul class="nav-links">
            <li>
              <a href="/"><i class="fa-solid fa-house"></i> Home</a>
            </li>
            <li>
              <a href="https://www.tileweaver.net/" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-cubes"></i> TileWeaver</a>
            </li>
            <% if (token !==null) { %>
              <li>
                <a href="/character-bank"><i class="fa-solid fa-users"></i> Character Bank</a>
              </li>
              <li>
                <a href="/chat-archives"><i class="fa-solid fa-box-archive"></i> Chat Archives</a>
              </li>
              <% } %>
          </ul>
          <div class="loginBox user-controls">
            <% if (token !==null) { %>
              <form action="/api/user/logout" method="POST">
                <button type="submit" class="btn btn-outline">Logout</button>
              </form>
              <% } else { %>
                <button type="button" onClick="hideFunction()" class="btn btn-outline" aria-label="Open Login Window">Login</button>
                <% } %>
                  <div class="loggedIn">
                    <% if (token !==null) { %>
                      <p style="color: var(--palette-parchment-dark); font-size: 0.9rem;">Logged In</p>
                      <% } %>
                  </div>
          </div>
        </div>
      </nav>

      <%- body %>

        <footer>
          <div class="container">
            <p>TastyTails~</p>
          </div>
        </footer>

        <script>
          /**
           * Toggles visibility of registration modal and smoke backdrop.
           * DEFENSIVE GUARD: Checks if elements exist before accessing classList
           * to prevent client-side JS TypeError exceptions on pages missing these elements.
           */
          function hideFunction() {
            var regBox = document.getElementsByClassName("registrationBox")[0];
            if (regBox) {
              var isHidden = regBox.classList.toggle("hide");
              regBox.setAttribute("aria-hidden", isHidden ? "true" : "false");
            }
            var smokeEl = document.getElementById("smoke");
            if (smokeEl) {
              smokeEl.classList.toggle("hide");
            }
          }
        </script>
</body>

</html>