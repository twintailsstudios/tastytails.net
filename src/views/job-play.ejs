<link rel="stylesheet" href="/css/job-demos.css">

<div class="page-header" style="margin-top: 100px;">
    <h1>
        <%= jobName.charAt(0).toUpperCase() + jobName.slice(1) %> Demo
    </h1>
    <p style="text-align: center; color: #eee; font-size: 1.2rem;">This is a placeholder for the <%= jobName %> gameplay
            demo.</p>
</div>

<div class="container" style="text-align: center;">
    <div
        style="background: rgba(255,255,255,0.1); padding: 40px; border-radius: 8px; border: 2px dashed #ccc; display: inline-block;">
        <i class="fa-solid fa-person-digging" style="font-size: 5rem; color: #eee; margin-bottom: 20px;"></i>
        <h2 style="color: #fff;">Work in Progress</h2>
        <p style="color: #ccc;">The interactive mechanics for this job are currently being developed.</p>
        <br>
        <a href="/job-demos" class="btn btn-play" style="max-width: 200px; margin: 0 auto;">
            <i class="fa-solid fa-arrow-left"></i> Back to Demos
        </a>
    </div>
</div>